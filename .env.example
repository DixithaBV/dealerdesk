# Copy to .env (never commit .env). Real environment variables always win over .env.
DATABASE_URL=postgres://user:password@localhost:5432/dealerdesk
# Free hosted option: Neon -> postgresql://user:pass@ep-xxxx.neon.tech/dealerdesk?sslmode=require

# LLM provider for the Dealer Assistant: Google Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supplier mock (python supplier_mock/mock_supplier.py prints these)
SUPPLIER_API_URL=http://127.0.0.1:8099
SUPPLIER_API_KEY=dev-supplier-key

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
